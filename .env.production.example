# ===================================
# 🚀 Production Environment Configuration
# ===================================

# Application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME="SmartVault Backend"
APP_VERSION=1.0.0

# ===================================
# 🔐 Security & Authentication
# ===================================

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Password Security
BCRYPT_ROUNDS=14

# Session Security
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_IN_PRODUCTION
SESSION_TIMEOUT=1800000

# ===================================
# 🗄️ Database Configuration
# ===================================

# Primary Database (Use RDS/Cloud SQL in production)
DATABASE_URL=mysql://prod_user:SECURE_PASSWORD@prod-db-host:3306/smartvault_prod
DB_HOST=prod-db-host
DB_PORT=3306
DB_USERNAME=prod_user
DB_PASSWORD=SECURE_DATABASE_PASSWORD
DB_DATABASE=smartvault_prod
DB_DIALECT=mysql

# Database Pool Configuration (Production optimized)
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=10000

# ===================================
# 📦 Redis Configuration
# ===================================

REDIS_URL=redis://redis-prod-host:6379
REDIS_HOST=redis-prod-host
REDIS_PORT=6379
REDIS_PASSWORD=SECURE_REDIS_PASSWORD
REDIS_DB=0
REDIS_KEY_PREFIX=smartvault:prod:

# ===================================
# 📧 Email Configuration
# ===================================

# SMTP Settings (Use SES/SendGrid in production)
SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=AKIAIOSFODNN7EXAMPLE
SMTP_PASS=SMTP_PASSWORD_HERE

# Email Templates
EMAIL_FROM="SmartVault <noreply@smartvault.com>"
EMAIL_SUPPORT=support@smartvault.com

# ===================================
# 🔄 Rate Limiting (Production strict)
# ===================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_SKIP_SUCCESS=false

# ===================================
# 📊 Monitoring & Logging
# ===================================

# Logging (Production levels)
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/app.log

# APM & Metrics
APM_ENABLED=true
METRICS_ENABLED=true
CORRELATION_ID_HEADER=x-correlation-id

# ===================================
# ☁️ Cloud & External Services
# ===================================

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=smartvault-prod-uploads

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=/app/uploads/

# ===================================
# 🔒 Security Headers & CORS
# ===================================

# CORS Configuration (Restrict to production domains)
CORS_ORIGIN=https://smartvault.com,https://app.smartvault.com
CORS_CREDENTIALS=true

# Security
TRUST_PROXY=true
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# ===================================
# 🚀 Performance & Caching
# ===================================

# Cache TTL (in seconds)
CACHE_TTL=3600
CACHE_PREFIX=cache:prod:

# Response Compression
COMPRESSION_THRESHOLD=1024

# ===================================
# 🧪 Development & Testing
# ===================================

# API Documentation (Disabled in production)
API_DOCS_ENABLED=false
API_DOCS_PATH=/api-docs

# Development Tools (Disabled in production)
DEBUG_ENABLED=false
PRETTY_PRINT_JSON=false

# ===================================
# 📱 Feature Flags
# ===================================

FEATURE_ADVANCED_AUTH=true
FEATURE_AUDIT_LOGGING=true
FEATURE_RATE_LIMITING=true
FEATURE_CACHING=true
