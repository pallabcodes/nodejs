# ===================================
# 🌍 Environment Configuration
# ===================================

# Application
NODE_ENV=development
PORT=3000
HOST=localhost
APP_NAME="SmartVault Backend"
APP_VERSION=1.0.0

# ===================================
# 🔐 Security & Authentication
# ===================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Password Security
BCRYPT_ROUNDS=12

# Session Security
SESSION_SECRET=your-session-secret-key-change-this
SESSION_TIMEOUT=3600000

# ===================================
# 🗄️ Database Configuration
# ===================================

# Primary Database
DATABASE_URL=mysql://username:password@localhost:3306/smartvault_dev
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=username
DB_PASSWORD=password
DB_DATABASE=smartvault_dev
DB_DIALECT=mysql

# Database Pool Configuration
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ===================================
# 📦 Redis Configuration
# ===================================

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=smartvault:

# ===================================
# 📧 Email Configuration
# ===================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Templates
EMAIL_FROM="SmartVault <noreply@smartvault.com>"
EMAIL_SUPPORT=support@smartvault.com

# ===================================
# 🔄 Rate Limiting
# ===================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=false

# ===================================
# 📊 Monitoring & Logging
# ===================================

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE_PATH=logs/app.log

# APM & Metrics
APM_ENABLED=true
METRICS_ENABLED=true
CORRELATION_ID_HEADER=x-correlation-id

# ===================================
# ☁️ Cloud & External Services
# ===================================

# AWS Configuration (if using)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# ===================================
# 🔒 Security Headers & CORS
# ===================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Security
TRUST_PROXY=true
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# ===================================
# 🚀 Performance & Caching
# ===================================

# Cache TTL (in seconds)
CACHE_TTL=300
CACHE_PREFIX=cache:

# Response Compression
COMPRESSION_THRESHOLD=1024

# ===================================
# 🧪 Development & Testing
# ===================================

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api-docs

# Development Tools
DEBUG_ENABLED=true
PRETTY_PRINT_JSON=true

# ===================================
# 📱 Feature Flags
# ===================================

FEATURE_ADVANCED_AUTH=true
FEATURE_AUDIT_LOGGING=true
FEATURE_RATE_LIMITING=true
FEATURE_CACHING=true
